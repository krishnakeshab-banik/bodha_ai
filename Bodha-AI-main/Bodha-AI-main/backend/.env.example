# Port the Bodha AI REST API listens on
PORT=4000

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Absolute or relative path to the SQLite database file (created on first run)
DATABASE_PATH=./data/bodha.db

# --- Listing optimizer -------------------------------------------------------
# Leave LLM_API_KEY empty to use the deterministic rule-based listing optimizer.
# Supplying a key is the single switch needed to route through a real LLM once
# an LLM-backed implementation is registered in services/listingOptimizer.ts.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Gemini powers the multilingual voice agent and language-aware listing copy.
# Leave empty to use template fallbacks (voice still answers from the report).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Live marketplace scrape -------------------------------------------------
# How long a scrape is reused before the next analyze hits the live page.
CACHE_TTL_HOURS=3
# Per-platform Playwright timeout (ms)
SCRAPE_TIMEOUT_MS=25000
# Cap of comparable cards extracted from page 1
SCRAPE_MAX_RESULTS=20
SCRAPE_HEADLESS=true

# --- Accounts & Razorpay test checkout --------------------------------------
# $10 / month Pro plan is billed as ₹830 (83000 paise) in Razorpay test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PRO_PRICE_PAISE=83000
FREE_ANALYSES_PER_MONTH=6
