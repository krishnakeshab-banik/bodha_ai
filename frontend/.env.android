# Used only by `npm run build:android` (Vite --mode android).
# The regular website build still reads `.env` with a blank base URL
# so /api stays same-origin and hits the Vite proxy.
#
# Physical phone on the same Wi‑Fi as this PC. Emulator would use 10.0.2.2.
# Rebuild the APK if your LAN IP changes.
VITE_API_BASE_URL=http://10.3.47.138:4000

