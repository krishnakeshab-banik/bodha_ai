# Base URL for the Bodha AI API.
# Left blank in development so requests go through the Vite dev-server proxy
# (see vite.config.ts) and stay same-origin. Set to an absolute URL in
# production, e.g. https://api.bodha.example.com
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Android packaged build (see .env.android) uses VITE_API_BASE_URL so the
# WebView can reach the same backend without the Vite proxy.

# Existing ElevenLabs Conversational AI agent (public id — not a secret).
# Do not create a new agent; this id must stay the one already configured.
VITE_ELEVENLABS_AGENT_ID=agent_3301m2486d2qecasbeht51m4ef4t
VITE_ELEVENLABS_BRANCH_ID=agtbrch_7501m2486ek8erka0cw0dy0y87d2

# "Sign in with Google" OAuth 2.0 Client ID from
# https://console.cloud.google.com/apis/credentials (same value as
# backend/.env's GOOGLE_CLIENT_ID — it's a public identifier, not a secret).
# Leave empty to hide the Google button on the login/signup pages.
VITE_GOOGLE_CLIENT_ID=
